# ==========================================
# Node / NestJS / TypeScript .gitignore
# ==========================================

# Node modules
node_modules/

# Build output
dist/
build/
out/

# Environment variables
.env
.env.local
.env.development
.env.production
.env.test

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage testing
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Nest CLI output
.nestcli.json

# Optional: exclude local scripts, seeds, etc.
src/infrastructure/database/seed/*.ts

# Optional: exclude compiled test files
test/**/*.js

# Optional: Docker
docker-compose.override.yml
docker-data/
