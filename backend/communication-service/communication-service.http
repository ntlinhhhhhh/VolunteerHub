### Variables
@baseUrl = http://localhost:8000
@eventId = 694612a2c0eab2c6832e6e7f
@postId = 67650d53c1234567890abcdf
@commentId = comment123
@userId = user123
@userName = John Doe
@userRole = volunteer

### 1. Get Posts (Latest)
GET {{baseUrl}}/events/{{eventId}}/posts?sortBy=latest&limit=10
Content-Type: application/json

### 2. Get Posts (Most Active)
GET {{baseUrl}}/events/{{eventId}}/posts?sortBy=most_active&limit=10
Content-Type: application/json

### 3. Create Post
# @name createPost
POST {{baseUrl}}/events/{{eventId}}/posts
Content-Type: application/json
x-user-id: {{userId}}
x-user-name: {{userName}}

{
  "eventId": "{{eventId}}",
  "authorId": "{{userId}}",
  "authorName": "{{userName}}",
  "content": "Chào mọi người! Mình rất vui được tham gia sự kiện này. Hẹn gặp các bạn! 🎉",
  "images": ["https://example.com/image1.jpg"]
}

### Set postId from create response
@postId = {{createPost.response.body.data.id}}

### 4. Get Post by ID
GET {{baseUrl}}/events/{{eventId}}/posts/{{postId}}
Content-Type: application/json

### 5. Update Post
PUT {{baseUrl}}/events/{{eventId}}/posts/{{postId}}
Content-Type: application/json
x-user-id: {{userId}}

{
  "content": "Nội dung đã được cập nhật",
  "images": []
}

### 6. Like Post
POST {{baseUrl}}/events/{{eventId}}/posts/{{postId}}/like
Content-Type: application/json
x-user-id: {{userId}}
x-user-name: {{userName}}

### 7. Add Comment
# @name addComment
POST {{baseUrl}}/events/{{eventId}}/posts/{{postId}}/comments
Content-Type: application/json
x-user-id: {{userId}}
x-user-name: {{userName}}

{
  "authorId": "{{userId}}",
  "authorName": "{{userName}}",
  "content": "Comment rất hay! Mình cũng nghĩ vậy."
}

### Set commentId from add comment response
@commentId = {{addComment.response.body.data.id}}

### 8. Update Comment
PUT {{baseUrl}}/events/{{eventId}}/posts/{{postId}}/comments/{{commentId}}
Content-Type: application/json
x-user-id: {{userId}}

{
  "content": "Comment đã được chỉnh sửa"
}

### 9. Delete Comment
DELETE {{baseUrl}}/events/{{eventId}}/posts/{{postId}}/comments/{{commentId}}
x-user-id: {{userId}}
x-user-role: {{userRole}}

### 10. Unlike Post
DELETE {{baseUrl}}/events/{{eventId}}/posts/{{postId}}/like
x-user-id: {{userId}}

### 11. Pin Post (Event Manager / Admin only)
PATCH {{baseUrl}}/events/{{eventId}}/posts/{{postId}}/pin
x-user-role: event_manager

### 12. Unpin Post (Event Manager / Admin only)
PATCH {{baseUrl}}/events/{{eventId}}/posts/{{postId}}/unpin
x-user-role: event_manager

### 13. Delete Post
DELETE {{baseUrl}}/events/{{eventId}}/posts/{{postId}}
x-user-id: {{userId}}
x-user-role: {{userRole}}

### 14. Get Posts with Pagination
GET {{baseUrl}}/events/{{eventId}}/posts?limit=5&skip=0
Content-Type: application/json

### 15. Load More Posts
GET {{baseUrl}}/events/{{eventId}}/posts?limit=5&skip=5
Content-Type: application/json