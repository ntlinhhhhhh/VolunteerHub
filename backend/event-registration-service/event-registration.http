### GET theo filter các sự kiện
GET http://localhost:8000/registrations?organizerId=693663ae445067d3c670ffb5&status=pending

### get các sự kiện mà bạn đã đăng ký - token của volunteer
GET http://localhost:8000/registrations/my-registrations
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..N2ubjJq0pie82bENufzCKI8vu8D0JYfnazcTdZFrDSo

#### thống kê các sự kiên của bạn - token của volunteer
GET http://localhost:8000/registrations/my-statistics
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Rd59PP_Te9GUu9rv-Smi45bJdp_8uGbZ7KyPciCa5KU

#### get một đang ký sự kiện theo id
GET http://localhost:8000/registrations/6936f894da14cdff5a070305

### tham gia một sự kiên - token của volunteer
POST http://localhost:8000/registrations/apply
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lfeVWRdZxWLxhDk-Sly_P0Ht3czizr-p-0vAlHxrR5M
Content-Type: application/json

{
  "eventId": "693a2b6dba5788d2304a84db",
  "roleId": "09c49ef4-6d95-4c06-a384-4f3f7712c52f",
  "motivation": "STUFY I want to help because I have experience volunteering in several community events and I am passionate about supporting people in need.",
  "skills": ["first aid", "organizing"],
  "availability": "weekends",
  "experience": "2 years volunteering",
  "emergencyContact": {
    "name": "Time Drake",
    "phone": "0123456789",
    "relationship": "Friend"
  }
}

### sau đó sự kiện đé sẽ đến người tạo sự kiên (thường quản lý sự kiên) hoặc có thể là admin (nhưng ít) để chập nhận - token của event-manager
PUT http://localhost:8000/registrations/693af080ae9a1543fa7b97f6/accept
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..K7jf7VuWVIheXNx8XtOR6_MFhbJ1JAtUyTmAypcFuT4
Content-Type: application/json

{

}

### hoặc từ chối - token của event-manager
PUT http://localhost:8000/registrations/693a954bae9a1543fa7b95a7/reject
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..9Bv9JuKdXC5aTyNeBCL2QPjTf7BbtKSz0JzXlk7eB24
Content-Type: application/json

{
    "rejectionReason": "Bạn chưa đủ điều kiện để tham gia sự kiện này"
}

### nếu được chập nhận --> confirm để tham gia - token của volunteer
PUT http://localhost:8000/registrations/693af105056ae0a28412167d/confirm
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..CF-UAQCMJR7kZx4cJdqYJp8atB7Xxob8_1eAIOjjg80


### Rate Event by Volunteer
PUT http://localhost:8000/registrations/693aa1fbae9a1543fa7b95b1/rate
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..0vFybQKMBn2jBMx3ryD4CDDeg7qktWCj9pBJjfuuR-k
