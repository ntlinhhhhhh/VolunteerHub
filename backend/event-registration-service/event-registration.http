### get tất cả registraion
GET http://localhost:8000/registrations

### GET sự kiện theo id
GET http://localhost:8000/registrations?eventId=69392b3ccd19460aadf9f53d

### lọc theo volunteerid
GET http://localhost:8000/registrations?volunteerId=693bef0948558080fd0ebd3e

### lọc theo status
GET http://localhost:8000/registrations?status=pending

### lọc theo thời gian
GET http://localhost:8000/registrations?dateFrom=2025-12-01T00:00:00.000Z&dateTo=2025-12-20T23:59:59.999Z

### loc giới hạn
GET http://localhost:8000/registrations?limit=10

# @IsOptional()
# @IsEnum(['createdAt', 'eventDate', 'checkInTime'])
# sortBy?: 'createdAt' | 'eventDate' | 'checkInTime' = 'createdAt';


# @IsOptional()
# @IsEnum(['asc', 'desc']) 
# sortOrder?: 'asc' | 'desc' = 'desc';
# asc: tăng dần
# desc: giảm dần

### lọc theo sort và tăng/giảm dần
GET http://localhost:8000/registrations?sortBy=createdAt&sortOrder=asc




### get các sự kiện mà bạn đã đăng ký - token của volunteer
GET http://localhost:8000/registrations/my-registrations
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..N2ubjJq0pie82bENufzCKI8vu8D0JYfnazcTdZFrDSo

#### thống kê các sự kiên của bạn - token của volunteer
GET http://localhost:8000/registrations/my-statistics
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..QRk_PRhvye6hqd5Q4V6XlE6uSKP9hoMYksiZG90HjxE

#### get một đang ký sự kiện theo id
GET http://localhost:8000/registrations/6936f894da14cdff5a070305

### tham gia một sự kiên - token của volunteer
POST http://localhost:8000/registrations/apply
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..p-GrAljEQ_DodyoFXndreVbW67F4TyMlmCUTzXZUjjM
Content-Type: application/json

{
  "eventId": "693bee98e5279822b61f81b3",
  "roleId": "a961ba44-ef15-4f16-9ecb-0e27327d6c98",
  "motivation": "STUFY I want to help because I have experience volunteering in several community events and I am passionate about supporting people in need.",
  "skills": ["first aid", "organizing"],
  "availability": "weekends",
  "experience": "2 years volunteering",
  "emergencyContact": {
    "name": "Time Drake",
    "phone": "0123456789",
    "relationship": "Friend"
  }
}

### sau đó sự kiện đé sẽ đến người tạo sự kiên (thường quản lý sự kiên) hoặc có thể là admin (nhưng ít) để chập nhận - token của event-manager
PUT http://localhost:8000/registrations/693bef6ee3261bbb3dcb01e1/accept
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..rENXPLr0VYcavOCjcIMlziDi8gopPvJedpvFT-LdH-Y
Content-Type: application/json

{

}

### hoặc từ chối - token của event-manager
PUT http://localhost:8000/registrations/693a954bae9a1543fa7b95a7/reject
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..9Bv9JuKdXC5aTyNeBCL2QPjTf7BbtKSz0JzXlk7eB24
Content-Type: application/json

{
    "rejectionReason": "Bạn chưa đủ điều kiện để tham gia sự kiện này"
}

### nếu được chập nhận --> confirm để tham gia - token của volunteer
PUT http://localhost:8000/registrations/693af105056ae0a28412167d/confirm
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..f1d3sUbsPagpKG0P907k_0OoukIHmy3OhpZNnqH9DXk


### Rate Event by Volunteer
PUT http://localhost:8000/registrations/693aa1fbae9a1543fa7b95b1/rate
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..0vFybQKMBn2jBMx3ryD4CDDeg7qktWCj9pBJjfuuR-k
Content-Type: application/json

{
  "stars": 5,
  "review": "Great experience, well organized"
}

### Cancel Registration by Volunteer
DELETE http://localhost:8000/registrations/6936fa715fceb4fb3420f034/cancel
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..IMGlQPs4UfwBugzpuSAL5OYMa8yaXwx-2enLsAgxDXk
Content-Type: application/json

{
  "cancellationReason": "Cannot attend due to personal reasons"
}

### Cancel Registration by Organizer
DELETE http://localhost:8000/registrations/6936e16ccfaf9a63064e71ec/cancel-by-organizer
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..oEBpBpUdUa8isHkdeVaJghLOrITtBVWripkt3dScUiE
Content-Type: application/json

{
  "cancellationReason": "Event slots reduced"
}

