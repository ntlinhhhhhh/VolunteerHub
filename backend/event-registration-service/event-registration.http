{
  "stars": 5,
  "review": "Great experience, well organized"
}

### Cancel Registration by Volunteer
DELETE http://localhost:8000/registrations/6936fa715fceb4fb3420f034/cancel
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..IMGlQPs4UfwBugzpuSAL5OYMa8yaXwx-2enLsAgxDXk
Content-Type: application/json

{
  "cancellationReason": "Cannot attend due to personal reasons"
}

### Cancel Registration by Organizer
DELETE http://localhost:8000/registrations/6936e16ccfaf9a63064e71ec/cancel-by-organizer
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..oEBpBpUdUa8isHkdeVaJghLOrITtBVWripkt3dScUiE
Content-Type: application/json

{
  "cancellationReason": "Event slots reduced"
}

