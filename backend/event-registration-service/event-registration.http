### GET theo filter các sự kiện
GET http://localhost:8000/registrations

### get các sự kiện mà bạn đã đăng ký - token của volunteer
GET http://localhost:8000/registrations/my-registrations
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..xYm-DVpln6AW6qZeQmdiwa0b-Udq7x38E8wTJwR_wLE

#### thống kê các sự kiên của bạn - token của volunteer
GET http://localhost:8000/registrations/my-statistics
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..A-FXTdA8cquYX3J8D-0cpV-1H5miDyOj-vg_3AhzOrk

#### get một đang ký sự kiện theo id
GET http://localhost:8000/registrations/6936f894da14cdff5a070305

### tham gia một sự kiên - token của volunteer
POST http://localhost:8000/registrations/apply
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lQS8Ot_PkTqy2HUhXH5GeJV-wtHz34tRfrT333Sd_1M
Content-Type: application/json

{
  "eventId": "6939555ec210a3d3b8a3afda",
  "roleId": "e4a17d41-387d-4fce-8de8-6ce2f8470a86",
  "motivation": "I want to help because I have experience volunteering in several community events and I am passionate about supporting people in need.",
  "skills": ["first aid", "organizing"],
  "availability": "weekends",
  "experience": "2 years volunteering",
  "emergencyContact": {
    "name": "John Doe",
    "phone": "0123456789",
    "relationship": "Friend"
  }
}

### sau đó sự kiện đé sẽ đến người tạo sự kiên (thường quản lý sự kiên) hoặc có thể là admin (nhưng ít) để chập nhận - token của event-manager
PUT http://localhost:8000/registrations/6939566cb9ce8aef4cd42500/accept
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..fmiY0Yh4b2BSOzO9iXpGBALFosS5BPZlyT1vEoiudsM
Content-Type: application/json

{

}

### hoặc từ chối - token của event-manager
PUT http://localhost:8000/registrations/6936f7aeda14cdff5a0702fd/reject
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..FGOiadCeqEaenvgoti5UtcZl9xzMxUL52yyN_MZ60BQ
Content-Type: application/json

{
    "rejectionReason": "Bạn chưa đủ điều kiện để tham gia sự kiện này"
}

### nếu được chập nhận --> confirm để tham gia - token của volunteer
PUT http://localhost:8000/registrations/6936f894da14cdff5a070305/confirm
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Hw2mTcIn_L76847lthrbF4l07PTC0PC0DT1Lvj9RzS4

### Check-in by Volunteer
PUT http://localhost:8000/registrations/6936e16ccfaf9a63064e71ec/check-in
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ybnZbAXLoggA0xV-tld7LEkDzFSxxTQOy1RP6A-NLC0
Content-Type: application/json

{
  "location": {
    "lat": 10.123456,
    "lng": 106.123456
  },
  "notes": "Arrived on time"
}

### Check-out by Volunteer
PUT http://localhost:8000/registrations/6936e16ccfaf9a63064e71ec/check-out
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ybnZbAXLoggA0xV-tld7LEkDzFSxxTQOy1RP6A-NLC0
Content-Type: application/json

{
  "notes": "Finished shift"
}

### Rate Event by Volunteer
PUT http://localhost:8000/registrations/6936e16ccfaf9a63064e71ec/rate
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ybnZbAXLoggA0xV-tld7LEkDzFSxxTQOy1RP6A-NLC0
Content-Type: application/json

{
  "stars": 5,
  "review": "Great experience, well organized"
}

### Cancel Registration by Volunteer
DELETE http://localhost:8000/registrations/6936fa715fceb4fb3420f034/cancel
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..IMGlQPs4UfwBugzpuSAL5OYMa8yaXwx-2enLsAgxDXk
Content-Type: application/json

{
  "cancellationReason": "Cannot attend due to personal reasons"
}

### Cancel Registration by Organizer
DELETE http://localhost:8000/registrations/6936e16ccfaf9a63064e71ec/cancel-by-organizer
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..oEBpBpUdUa8isHkdeVaJghLOrITtBVWripkt3dScUiE
Content-Type: application/json

{
  "cancellationReason": "Event slots reduced"
}

### Check-in by Organizer (by code)
POST http://localhost:4000/registrations/check-in-by-code
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "code": "REG123456",
  "location": {
    "latitude": 10.123456,
    "longitude": 106.123456
  },
  "notes": "Checked in manually by organizer"
}

### Check-out by Organizer (by code)
POST http://localhost:4000/registrations/check-out-by-code
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "code": "REG123456",
  "notes": "Checked out manually by organizer"
}

### Complete Registration by Organizer
PUT http://localhost:4000/registrations/REGISTRATION_ID/complete
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

### Rate Volunteer by Organizer
PUT http://localhost:4000/registrations/REGISTRATION_ID/rate-volunteer
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "performance": 5,
  "punctuality": 4,
  "teamwork": 5,
  "comment": "Volunteer performed excellently"
}


### rating volunteer
PUT http://localhost:8000/registrations/6936e16ccfaf9a63064e71ec/rate-volunteer
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..u1zIw15E156Z_6M_lA8qDJTOKuo5fwsz1gkBJ75LD4I
Content-Type: application/json

{
  "performance": 5,
  "punctuality": 4,
  "teamwork": 5,
  "comment": "Volunteer rất chủ động, phối hợp nhóm tốt và hoàn thành nhiệm vụ xuất sắc."
}